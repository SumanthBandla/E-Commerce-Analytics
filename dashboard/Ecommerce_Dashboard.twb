  <worksheets>
  <worksheet name='KPI - Total Sales'>
    <table>
      <view>
        <datasources>
          <datasource caption='ecommerce_clean' name='ecommerce_clean' />
        </datasources>
        <datasource-dependencies>
    <column caption='Sales' datatype='real' name='SUM([Sales])' role='measure' type='quantitative' />
        </datasource-dependencies>
        <aggregation>true</aggregation>
        <style>
          <class value='tab' />
          <mark value='Automatic' />
        </style>
        <rows>

        </rows>
        <cols>
        <column datatype='real' name='SUM([Sales])' role='measure' type='quantitative' />
        </cols>
        <panes>
          <pane>
            <view-formats />
            <inner-panes>
              <pane>
                <view-formats />
                <mark class='Text' />
              </pane>
            </inner-panes>
          </pane>
        </panes>
      </view>
    </table>
  </worksheet>
