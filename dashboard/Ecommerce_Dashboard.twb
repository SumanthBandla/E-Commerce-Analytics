          <zone h='300' w='700' x='700' y='600' name='Bottom 10 Products by Profit' style-version='2' type='worksheet' />
          <zone h='300' w='600' x='1400' y='600' name='Discount vs Profit' style-version='2' type='worksheet' />
          <zone h='380' w='2000' x='0' y='900' name='Geographic Sales Analysis' style-version='2' type='worksheet' />
        </zone>
      </zone>
    </zones>
    <quickfilters>
      <quickfilter name='Year' worksheet='Monthly Sales Trend' style-version='2' zone-id='qf-0'>
        <zone id='qf-0' name='Year' style-version='2' type='quickfilter' />
      </quickfilter>
      <quickfilter name='Month' worksheet='Monthly Sales Trend' style-version='2' zone-id='qf-1'>
        <zone id='qf-1' name='Month' style-version='2' type='quickfilter' />
      </quickfilter>
      <quickfilter name='Category' worksheet='Monthly Sales Trend' style-version='2' zone-id='qf-2'>
        <zone id='qf-2' name='Category' style-version='2' type='quickfilter' />
      </quickfilter>
      <quickfilter name='Sub-Category' worksheet='Monthly Sales Trend' style-version='2' zone-id='qf-3'>
        <zone id='qf-3' name='Sub-Category' style-version='2' type='quickfilter' />
      </quickfilter>
      <quickfilter name='Region' worksheet='Monthly Sales Trend' style-version='2' zone-id='qf-4'>
        <zone id='qf-4' name='Region' style-version='2' type='quickfilter' />
      </quickfilter>
      <quickfilter name='Segment' worksheet='Monthly Sales Trend' style-version='2' zone-id='qf-5'>
        <zone id='qf-5' name='Segment' style-version='2' type='quickfilter' />
      </quickfilter>
      <quickfilter name='Customer Name' worksheet='Monthly Sales Trend' style-version='2' zone-id='qf-6'>
        <zone id='qf-6' name='Customer Name' style-version='2' type='quickfilter' />
      </quickfilter>
      <quickfilter name='Product Name' worksheet='Monthly Sales Trend' style-version='2' zone-id='qf-7'>
        <zone id='qf-7' name='Product Name' style-version='2' type='quickfilter' />
      </quickfilter>
    </quickfilters>
  </dashboard>

  <windows>
